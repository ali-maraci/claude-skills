# Copy to ~/.config/bug-hunt/.env (mode 600). Keep the ~/.config/bug-hunt/staging-origins.txt file next to it.

# The staging web app. Its origin must be listed in staging-origins.txt.
APP_WEB_STAGING_URL=https://staging.example.test

# The test mailbox (plus-addressing, IMAP app password). QA_MAILBOX_BASE has no +tag.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=qa@example.test
IMAP_APP_PASSWORD=<app password>
QA_MAILBOX_BASE=qa@example.test

# A gitignored folder outside any repo, or inside one that ignores it.
RUNS_DIR=~/bug-hunt/runs

# Exact subject line of the app's sign-in-code email (required).
OTP_SUBJECT=Your sign-in code
# A page that redirects to the login page when signed out (required; a public "/" would pass while signed out).
SIGNED_IN_PATH=/account

# Optional, with their defaults:
# LOGIN_PATH=/login
# EMAIL_LABEL=Email address
# SUBMIT_LABEL=Continue
# CODE_LABEL=Code
#   If CODE_LABEL contains {n}, the code is typed into six boxes named with {n}=1..6, e.g. "Digit {n}".
# RATE_LIMITED_TEXT=
#   Text the app shows when it throttles code requests; empty = no rate-limit retry.
# OTP_BUDGET_PER_HOUR=8
# OTP_BUDGET_PER_EMAIL=3
