# Copy this directory to ~/.config/feature-showcase and rename env.example to .env.
ELEVENLABS_API_KEY=sk_replace_me
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=replace_me
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

APP_WEB_STAGING_URL=https://app.staging.example.test
# A page that redirects to login when signed out (a public / would pass while signed out).
APP_WEB_SIGNED_IN_PATH=/dashboard

# Optional second surface: set both or neither.
# PORTAL_STAGING_URL=https://portal.staging.example.test
# PORTAL_SIGNED_IN_PATH=/dashboard

# Optional: shown before the ticket key on title and recap cards.
# SHOWCASE_BRAND=Example App

SHOWCASE_OUTPUT_DIR=~/showcases
